# Copy this file to .env for local settings. Keep .env uncommitted.
#
# The API and deployment entrypoints expect these values in the process
# environment. Benchmark tracking utilities also read key=value pairs from .env.

# Persistent API storage. Leave unset for in-memory/local-only behavior.
# CALIBRE_DATABASE_URL=postgresql+psycopg://calibre:calibre@localhost:5432/calibre

# Persist /fit and /tune lifecycle state in Postgres. Requires CALIBRE_DATABASE_URL.
# LIFECYCLE_STORE=sql

# Base URI for fit-frame parquet artifacts. Use shared object storage for
# multi-worker deployments; local paths are single-host only.
# CALIBRE_ARTIFACT_URI=s3://my-bucket/calibre/artifacts

# Test-only Postgres URL used by integration tests when available.
# CALIBRE_TEST_DATABASE_URL=postgresql+psycopg://calibre:calibre@localhost:5432/calibre

# MLflow benchmark tracking. Defaults to ./mlruns when unset.
# MLFLOW_TRACKING_URI=mlruns

# Disable MLflow tracking for benchmarks.
# CALIBRE_NO_MLFLOW=1

# Optional Ray Tune results directory.
# RAYTUNE_RESULTS_DIR=.ray_results

# Keep Ray from using uv runtime-env handling; the repo sets this by default.
# RAY_ENABLE_UV_RUN_RUNTIME_ENV=0

# Optional local project-memory vault path for agents.
# OBSIDIAN_VAULT_PATH=C:\Users\you\Documents\Obsidian
